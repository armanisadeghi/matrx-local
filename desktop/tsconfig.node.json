{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./dist-node",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "types": ["node"]
  },
  // `vite-plugins/**` is Vite-config-time code (Node), and it shares MXL-D-091's guard with the
  // browser in `src/lib/harness-bridge-contract.ts` — one copy of the rule, so the two cannot
  // drift. Both are type-checked here.
  "include": ["vite.config.ts", "vite-plugins/**/*.ts", "src/lib/harness-bridge-contract.ts"]
}
