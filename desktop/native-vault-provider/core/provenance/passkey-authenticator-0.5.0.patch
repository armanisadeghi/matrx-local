diff --git a/src/authenticator.rs b/src/authenticator.rs
index c071449..7cda19e 100644
--- a/src/authenticator.rs
+++ b/src/authenticator.rs
@@ -6,6 +6,46 @@ use passkey_types::{
 
 use crate::{CredentialStore, UserValidationMethod, user_validation::UiHint};
 
+/// Validated CTAP backup eligibility and state bits.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct BackupFlags {
+    eligible: bool,
+    backed_up: bool,
+}
+
+impl BackupFlags {
+    /// Legacy device-bound credentials advertise neither backup bit.
+    pub const DEVICE_BOUND: Self = Self {
+        eligible: false,
+        backed_up: false,
+    };
+
+    /// Reject the invalid CTAP combination where a non-eligible key is backed up.
+    pub fn new(eligible: bool, backed_up: bool) -> Result<Self, Ctap2Error> {
+        if backed_up && !eligible {
+            return Err(Ctap2Error::InvalidOption);
+        }
+        Ok(Self {
+            eligible,
+            backed_up,
+        })
+    }
+
+    pub(crate) fn apply(self, mut flags: Flags) -> Flags {
+        // `Flags::default()` in passkey-types currently carries BE|BS. Backup state
+        // is credential truth, so first clear those inherited bits, then write this
+        // validated pair while preserving UP, UV, AT, ED, and every other flag.
+        flags.remove(Flags::BE | Flags::BS);
+        if self.eligible {
+            flags.insert(Flags::BE);
+        }
+        if self.backed_up {
+            flags.insert(Flags::BS);
+        }
+        flags
+    }
+}
+
 pub mod extensions;
 mod get_assertion;
 mod get_info;
