+    /// Decode the next string through the maintained decoder after a raw-range
+    /// probe bounds escaped input. This private patch gives schema walkers a
+    /// bounded API without exposing their scratch tape.
+    pub fn next_bounded_str(&mut self, raw_limit: usize, decoded_limit: usize) -> JiterResult<String> {
+        let mut probe = self.parser.clone();
+        let peek = probe.peek()?;
+        if peek != Peek::String { return Err(self.wrong_type(JsonType::String, peek)); }
+        let range = probe.consume_string::<StringDecoderRange>(&mut Tape::new(), self.allow_partial_strings)?;
+        let raw = &self.data[range];
+        if raw.len() > raw_limit { return Err(crate::errors::JiterError::new(crate::errors::JiterErrorType::JsonError(crate::errors::JsonErrorType::ExpectedSomeValue), self.current_index())); }
+        let value = self.next_str()?;
+        if value.len() > decoded_limit { return Err(crate::errors::JiterError::new(crate::errors::JiterErrorType::JsonError(crate::errors::JsonErrorType::ExpectedSomeValue), self.current_index())); }
+        Ok(value.to_owned())
+    }
+
+    /// Decode an object first key through the bounded maintained decoder.
+    pub fn next_bounded_object_key(&mut self, raw_limit: usize, decoded_limit: usize) -> JiterResult<Option<String>> {
+        let mut probe = self.parser.clone();
+        let peek = probe.peek()?;
+        if peek != Peek::Object { return Err(self.wrong_type(JsonType::Object, peek)); }
+        let range = probe.object_first::<StringDecoderRange>(&mut Tape::new())?;
+        let raw = range.map(|range| &self.data[range]);
+        if raw.is_some_and(|value| value.len() > raw_limit) { return Err(crate::errors::JiterError::new(crate::errors::JiterErrorType::JsonError(crate::errors::JsonErrorType::ExpectedSomeValue), self.current_index())); }
+        let key = self.next_object()?;
