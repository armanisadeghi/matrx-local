<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.application-identifier</key>
    <string>JH83UH9P4D.com.aimatrx.desktop</string>
    <key>com.apple.developer.team-identifier</key>
    <string>JH83UH9P4D</string>
    <!-- ── Hardened Runtime: PyInstaller / ctypes / cffi compatibility ─────── -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- ── Hardware devices ───────────────────────────────────────────────── -->
    <!-- Microphone: audio recording, TranscribeAudio, RecordAudio, live transcription -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Camera: image capture tools -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Screen capture: local_screenshot tool and AI automation workflows.
         NSScreenCaptureUsageDescription in Info.plist provides the user-facing
         reason string. This entitlement is required in the signed binary for
         macOS to show the TCC prompt — without it the prompt never fires. -->
    <key>com.apple.security.screen-capture</key>
    <true/>

    <!-- ── Automation / Apple Events ─────────────────────────────────────── -->
    <!-- Required for osascript / System Events keyboard & window automation -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- ── File system ───────────────────────────────────────────────────── -->
    <!-- Full Disk Access: required for reading ~/Library/Messages/chat.db,
         ~/Library/Mail/, and arbitrary user files outside the app sandbox.
         Must be paired with a TCC grant in System Settings → Privacy → Full Disk Access. -->
    <key>com.apple.security.files.all</key>
    <true/>

    <!-- ── Bluetooth ──────────────────────────────────────────────────────── -->
    <!-- Required for CoreBluetooth scanning and device discovery on macOS 12+. -->
    <key>com.apple.security.device.bluetooth</key>
    <true/>

    <!-- ── Personal information ───────────────────────────────────────────── -->
    <key>com.apple.security.personal-information.addressbook</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Reminders use EventKit (same TCC service group as calendars) but need
         their own entitlement key for the hardened runtime. -->
    <key>com.apple.security.personal-information.reminders</key>
    <true/>
    <key>com.apple.security.personal-information.photos-library</key>
    <true/>

    <!-- ── Network ────────────────────────────────────────────────────────── -->
    <!-- Outbound network connections (API calls, engine discovery) -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- The host sees only nonsecret provider status/invalidation state. The
         provider-only Keychain access group remains absent from this target. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.aimatrx.desktop.vault-status</string>
    </array>
</dict>
</plist>
