{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimatrx.com/schemas/image-gen-runtime-target-v1.json",
  "title": "AI Matrx target-specific hash-locked image runtime",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "target",
    "python_minor",
    "contract_sha256",
    "lock_file",
    "lock_sha256",
    "packages"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "target": {
      "enum": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "x86_64-unknown-linux-gnu"
      ]
    },
    "python_minor": { "const": "3.13" },
    "contract_sha256": { "$ref": "#/$defs/sha256" },
    "lock_file": { "type": "string", "pattern": "\\.requirements\\.txt$" },
    "lock_sha256": { "$ref": "#/$defs/sha256" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "wheels"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "wheels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["filename", "url", "sha256"],
              "properties": {
                "filename": { "type": "string", "pattern": "\\.whl$" },
                "url": { "type": "string", "pattern": "^https://" },
                "sha256": { "$ref": "#/$defs/sha256" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
