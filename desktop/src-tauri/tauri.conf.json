{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/config.schema.json",
  "productName": "AI Matrx",
  "identifier": "com.aimatrx.desktop",
  "version": "1.4.55",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "AI Matrx",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' blob:; connect-src 'self' blob: http://127.0.0.1:* ws://127.0.0.1:* https://*.supabase.co wss://*.supabase.co https://*.huggingface.co https: wss:; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; frame-src 'self' blob: http://127.0.0.1:* https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "sidecar/matrx-engine",
      "sidecar/cloudflared",
      "binaries/llama-server",
      "binaries/uv"
    ],
    "windows": {
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 200 },
        "applicationFolderPosition": { "x": 480, "y": 200 }
      }
    },
    "linux": {
      "deb": {
        "depends": ["libasound2", "libgomp1", "libwebkit2gtk-4.1-0"]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": "((mailto|tel):[^\\s]+|https?://[^\\s]+|x-apple\\.systempreferences:[^\\s]+)"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["aimatrx"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/armanisadeghi/matrx-local/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUxNEJEOEY2QTc2RkRDNTkKUldSWjNHK245dGhMNGZKOWJHM0tucnUzUkY3M3hJd1hpQ09YdEJhZGN4V01UNE85ZG9sY0ZraUIK"
    }
  }
}
