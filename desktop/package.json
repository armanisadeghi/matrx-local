{
  "name": "aimatrx-desktop",
  "private": true,
  "version": "1.4.206",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:harness": "vite build --mode harness",
    "preview:harness": "vite preview --mode harness",
    "sync-types": "node scripts/sync-types.mjs",
    "sync-types:local": "node scripts/sync-types.mjs --local",
    "sync-types:fast": "node scripts/sync-types.mjs --fast",
    "ensure:syncd": "bash ../scripts/build-syncd.sh",
    "ensure:egress": "bash ../scripts/build-egress.sh --sidecar",
    "ensure:macos-helpers": "bash ../scripts/stage-macos-helpers.sh",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "(pnpm check:mandate-references || true) && pnpm ensure:macos-helpers && tauri build",
    "typecheck": "tsc -b --pretty false",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:boot": "playwright test boot.spec.ts",
    "test:boot:prod": "SMOKE_PREVIEW=1 playwright test boot.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:setup": "node e2e/setup/create-test-user.mjs",
    "check:matrx-packages": "node scripts/check-matrx-packages.mjs",
    "check:matrx-latest": "node scripts/check-matrx-packages.mjs",
    "sync:matrx-packages": "pnpm update -r \"@ai-matrx/*\" --latest && pnpm check:matrx-packages",
    "check:archived-items-law": "node scripts/check-archived-items-law.mjs",
    "check:archived-items-law:self-test": "node scripts/check-archived-items-law.mjs --self-test",
    "check:canonical-pickers": "node scripts/check-canonical-pickers.mjs",
    "check:org-default-ban": "node scripts/check-org-default-ban.mjs",
    "check:org-default-ban:self-test": "node scripts/check-org-default-ban.mjs --self-test",
    "check:code-prompts": "node scripts/check-code-prompts.mjs",
    "check:code-prompts:self-test": "node scripts/check-code-prompts.mjs --self-test",
    "check:canonical-pickers:self-test": "node scripts/check-canonical-pickers.mjs --self-test",
    "check:package-twins": "node scripts/check-package-twins.mjs --strict",
    "check:package-twins:self-test": "node scripts/check-package-twins.mjs --self-test",
    "check:native-confirm": "node scripts/check-native-confirm.mjs",
    "check:native-confirm:self-test": "node scripts/check-native-confirm.mjs --self-test",
    "check:native-vault-provider-hook": "node scripts/check-native-vault-provider-hook.cjs",
    "check:signout-scope": "node scripts/check-signout-scope.mjs",
    "check:signout-scope:self-test": "node scripts/check-signout-scope.mjs --self-test",
    "check:session-custody": "node scripts/check-session-custody.mjs",
    "check:session-custody:self-test": "node scripts/check-session-custody.mjs --self-test",
    "check:mandate-references": "uvx --from matrx-mandate-scan==0.2.2 matrx-mandate-scan check",
    "check:mandate-references:strict": "uvx --from matrx-mandate-scan==0.2.2 matrx-mandate-scan check --strict"
  },
  "dependencies": {
    "@ai-matrx/agents": "latest",
    "@ai-matrx/content-ir": "latest",
    "@ai-matrx/content-ir-react": "latest",
    "@ai-matrx/design-system": "latest",
    "@ai-matrx/kit": "latest",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "@tauri-apps/plugin-store": "^2.4.5",
    "@tauri-apps/plugin-updater": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "rehype-raw": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "tauri-plugin-macos-permissions-api": "^2.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2.11.5",
    "@types/node": "^25.9.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
