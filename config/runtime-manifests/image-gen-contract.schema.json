{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aimatrx.com/schemas/image-gen-runtime-contract-v1.json",
  "title": "AI Matrx image-generation runtime contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "python_minor",
    "contract_sha256",
    "lock_graph_sha256",
    "lock_source",
    "managed_requirements",
    "managed_direct_versions",
    "shared_distributions",
    "shared_import_map",
    "shared_import_packages",
    "critical_frozen_modules",
    "runtime_imports",
    "runtime_attributes"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "python_minor": { "const": "3.13" },
    "contract_sha256": { "$ref": "#/$defs/sha256" },
    "lock_graph_sha256": { "$ref": "#/$defs/sha256" },
    "lock_source": { "const": "uv.lock" },
    "managed_requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "managed_direct_versions": { "$ref": "#/$defs/stringMap" },
    "shared_distributions": { "$ref": "#/$defs/stringList" },
    "shared_import_map": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/stringList" }
    },
    "shared_import_packages": { "$ref": "#/$defs/stringList" },
    "critical_frozen_modules": { "$ref": "#/$defs/stringList" },
    "runtime_imports": { "$ref": "#/$defs/stringList" },
    "runtime_attributes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/stringList" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "stringList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "stringMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
